  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.0",
    "expo": "~56.0.5",
    "expo-blur": "~56.0.3",
    "expo-clipboard": "~56.0.4",
    "expo-constants": "~56.0.16",
    "expo-font": "~56.0.5",
    "expo-haptics": "^56.0.3",
    "expo-image-manipulator": "^56.0.15",
    "expo-image-picker": "^56.0.14",
    "expo-linking": "~56.0.12",
    "expo-router": "~56.2.7",
    "expo-speech-recognition": "^56.0.0",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.5",
    "expo-web-browser": "~56.0.5",
    "lucide-react-native": "^1.16.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-qrcode-svg": "^6.3.24",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "^15.15.5",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "~19.2.2",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "test:pix": "tsc --noEmit -p tests/tsconfig.json && node --import tsx --test tests/pix.test.ts",
    "start": "EXPO_UNSTABLE_HEADLESS=1 expo start",
    "android": "node scripts/verify-android-deps.js && EXPO_UNSTABLE_HEADLESS=1 expo run:android --device",
    "android:direct": "EXPO_UNSTABLE_HEADLESS=1 expo run:android --device",
    "logs": "adb logcat -c && adb logcat '*:S' ReactNative:V ReactNativeJS:V Expo:V AndroidRuntime:E",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild:android": "expo prebuild --platform android",
    "build:apk": "cd android && ./gradlew assembleRelease",
    "emu": "bash scripts/start-emulator.sh"
  },
  "private": true
}
