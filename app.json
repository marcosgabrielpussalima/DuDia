{
  "expo": {
    "name": "Dudia",
    "slug": "dudia",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/branding/DudiaL.png",
    "scheme": "dudia",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dudia.app"
    },
    "android": {
      "package": "com.dudia.app",
      "adaptiveIcon": {
        "backgroundColor": "#3bb58d",
        "foregroundImage": "./assets/branding/DudiaL.png",
        "monochromeImage": "./assets/branding/DudiaL.png"
      },
      "permissions": [
        "RECORD_AUDIO",
        "VIBRATE",
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#3bb58d"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Dudia usa fotos para ilustrar seus produtos.",
          "cameraPermission": "O Dudia usa a câmera para fotografar produtos."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "O Dudia precisa do microfone para registrar vendas por voz.",
          "speechRecognitionPermission": "O Dudia usa reconhecimento de voz para comandos de venda."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "local-dudia"
      }
    }
  }
}
